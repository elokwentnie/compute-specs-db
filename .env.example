# Environment: "development" or "production"
ENVIRONMENT=development

# Required in production — password for the admin panel
ADMIN_PASSWORD=changeme

# Required in production — secret key for signing JWT tokens
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# Optional — enable admin UI (default: false)
ENABLE_ADMIN_UI=true

# Optional — max upload size in bytes (default: 5 MB)
MAX_UPLOAD_BYTES=5242880

# Optional — Groq API key for the "Ask" chat feature (get one at console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# Optional — enable the Ask chat feature (default: false)
ENABLE_ASK_FEATURE=false
