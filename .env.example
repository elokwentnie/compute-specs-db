# Environment: "development" or "production"
ENVIRONMENT=development

# Required in production — password for the admin panel
ADMIN_PASSWORD=changeme

# Required in production — secret key for signing JWT tokens
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# Optional — enable admin UI (default: false)
ENABLE_ADMIN_UI=true

# Optional — max upload size in bytes (default: 5 MB)
MAX_UPLOAD_BYTES=5242880

# Optional — Groq API key for the "Ask" chat feature (get one at console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# Optional — enable the Ask chat feature (default: false)
ENABLE_ASK_FEATURE=false

# Optional — Groq model for Ask. Default: openai/gpt-oss-120b, then openai/gpt-oss-20b and qwen/qwen3.8-27b;
# if none is available to your key, the app picks a chat model the key can use (see the Render logs).
# Groq retires models regularly; see console.groq.com/docs/deprecations. Leave unset to use the defaults.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional — commit admin edits to the CSVs on GitHub and enable public proposals.
# Fine-grained PAT scoped to this repo: Contents (read/write) + Issues (read/write).
# Point GITHUB_REPO at a fork while testing.
GITHUB_TOKEN=
GITHUB_REPO=elokwentnie/compute-specs-db
GITHUB_BRANCH=main
